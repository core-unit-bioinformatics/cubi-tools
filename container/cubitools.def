BootStrap: docker
From: python:3.11-slim

%labels
    Author "Core Unit Bioinformatics"
    Description "CUBI Tools - Utility scripts of the Core Unit Bioinformatics"
    Homepage "https://github.com/core-unit-bioinformatics/cubi-tools"

%environment
    export PATH="/usr/local/bin:$PATH"
    export PYTHONUNBUFFERED=1
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

%post
    # Update system packages
    apt-get update
    apt-get install -y --no-install-recommends \
        git \
        openssh-client \
        build-essential \
        ca-certificates \
        libpam0g \
        stow \
    && rm -rf /var/lib/apt/lists/*

    # the way the dotfiles repo is organized is only compatible
    # with stow v2.4+ /// check here that we have that version
    installed=$(stow --version | awk '/version/ {print $NF; exit}')

    if [[ $(printf '%s\n' "$installed" "2.4.0" | sort -V | head -n1) != "2.4.0" ]]; then
        echo "stow 2.4+ required, found $installed" >&2
        exit 1
    fi

    # Install Python build dependencies
    pip install --upgrade pip setuptools setuptools-scm wheel

    # Clone the repository and checkout latest tagged release on dev branch
    git clone https://github.com/core-unit-bioinformatics/cubi-tools.git /tmp/cubi-tools
    cd /tmp/cubi-tools
    git fetch --tags
    LATEST_TAG=$(git tag --list --merged dev --sort=-version:refname | head -n 1)
    if [ -z "$LATEST_TAG" ]; then
        LATEST_TAG=$(git tag --list --sort=-version:refname | head -n 1)
    fi
    git checkout "$LATEST_TAG"

    # Set dynamic version label
    echo "Version=$LATEST_TAG" >> "$APPTAINER_LABELS"

    # Install cubitools
    pip install .

    # Clean up build artifacts
    rm -rf /tmp/cubi-tools

%runscript
    exec "$@"

%startscript
    exec "$@"
